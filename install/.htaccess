# Security: block direct web access to the installer/reset utilities on a live,
# already-installed site. These are administrative scripts (DB reset, importer)
# that must never be reachable over HTTP. For a controlled reinstall, remove or
# rename this file temporarily.
<IfModule mod_authz_core.c>
    # Apache 2.4+
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    # Apache 2.2
    Order Allow,Deny
    Deny from all
</IfModule>
