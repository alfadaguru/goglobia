              { "key": "TokenCode", "value": "{{tokenCode}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productID\": \"{{productID}}\",\n  \"productCode\": \"{{productCode}}\",\n  \"schemeCode\": \"{{schemeCode}}\",\n  \"productClassify\": 1,\n  \"mode\": 1,\n  \"productDateStart\": \"{{productDateStart}}\",\n  \"productDateEnd\": \"{{productDateEnd}}\"\n}"
            },
