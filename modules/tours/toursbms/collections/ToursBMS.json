    {
      "name": "5 — Incremental Sync",
      "item": [
        {
          "name": "Get Product Updates",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "const events = Array.isArray(json.data) ? json.data : [];",
                  "console.log('Update events:', events.length);",
                  "events.slice(0, 5).forEach(e => console.log(' -', e.updateType, e.productID, e.noteTime || e.noteTimeTz));",
                  "if (events.length && events[0].productID) {",
                  "    pm.collectionVariables.set('productID', events[0].productID);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "TokenCode", "value": "{{tokenCode}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productID\": \"\",\n  \"noteTimeStart\": \"{{noteTimeStart}}\",\n  \"noteTimeEnd\": \"{{noteTimeEnd}}\",\n  \"productClassify\": 0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/openapi/v1/product/getProductUpdates",
              "host": ["{{baseUrl}}"],
              "path": ["openapi", "v1", "product", "getProductUpdates"]
            },
            "description": "Change log for incremental sync. `updateType` tells which API to re-call (e.g. 3→getProductInfo, 4→getProductDate). `noteTimeStart` / `noteTimeEnd` are mandatory (yyyy-MM-dd HH:mm:ss)."
          }
        },
        {
          "name": "Get Product Updates (Single Product)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "TokenCode", "value": "{{tokenCode}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productID\": \"{{productID}}\",\n  \"noteTimeStart\": \"{{noteTimeStart}}\",\n  \"noteTimeEnd\": \"{{noteTimeEnd}}\",\n  \"productClassify\": 1\n}"
            },
