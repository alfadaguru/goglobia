              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const scheme = pm.variables.get('schemeCode');",
                  "if (!scheme) {",
                  "    console.warn('schemeCode is empty — pick a product from Get Product List that has schemeList, or set schemeCode manually.');",
                  "}"
                ]
              }
            }
