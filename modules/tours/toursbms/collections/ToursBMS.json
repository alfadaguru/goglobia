{
  "info": {
    "_postman_id": "d8d6b6c4-f8b0-4e53-9d3f-8b4f90b6d001",
    "name": "ToursBMS Product API",
    "description": "Complete ToursBMS Product Information Open API (ENG-ProductOpenApi.doc v1.0.5).\n\n**Base URL:** `http://api.toursbms.com`\n**Auth:** `TokenCode` header (empty only for getMerchantToken)\n**Signature:** `MD5(merchantId + secretKey + timestamp)` uppercase\n\n**Important:** Live `getProductDate` requires **`productCode`** (R-code, e.g. R0005790), not just `productID`. Always run **Get Product List** first — it saves both.\n\n**`schemeCode`** is only for package products (`schemeList` non-empty). Do not use the Package requests on normal tours.\n\n**Booking confirm/cancel:** NOT in this doc. See folder **6 — Booking** and ask ToursBMS for their Order/Booking API spec.\n\n**Flow:** Token → Product List → Product Info → Product Date → (optional) Promote Info",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://api.toursbms.com" },
    { "key": "merchantId", "value": "MI000113" },
    { "key": "vendorToken", "value": "c2a980cb9163b895e581c32f32f7d06c" },
    { "key": "secretKey", "value": "c2a980cb9163b895e581c32f32f7d06c" },
    { "key": "timestamp", "value": "" },
    { "key": "signature", "value": "" },
    { "key": "tokenCode", "value": "" },
    { "key": "productID", "value": "P00008808" },
    { "key": "productCode", "value": "R0005790" },
    { "key": "schemeCode", "value": "" },
    { "key": "hasPackageScheme", "value": "false" },
    { "key": "promoteCode", "value": "" },
    { "key": "regionCode", "value": "" },
    { "key": "productDateStart", "value": "2026-08-01" },
    { "key": "productDateEnd", "value": "2026-09-30" },
    { "key": "noteTimeStart", "value": "2026-07-01 00:00:00" },
    { "key": "noteTimeEnd", "value": "2026-07-09 23:59:59" }
  ],
  "item": [
    {
      "name": "0 — Authentication",
      "item": [
        {
          "name": "Get Merchant Token",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const merchantId = pm.environment.get('merchantId') || pm.collectionVariables.get('merchantId');",
                  "const secretKey = pm.environment.get('secretKey') || pm.environment.get('vendorToken') || pm.collectionVariables.get('secretKey') || pm.collectionVariables.get('vendorToken');",
                  "const timestamp = Math.floor(Date.now() / 1000).toString();",
                  "const signature = CryptoJS.MD5(merchantId + secretKey + timestamp).toString().toUpperCase();",
                  "pm.collectionVariables.set('timestamp', timestamp);",
                  "pm.collectionVariables.set('signature', signature);",
                  "console.log('merchantId:', merchantId);",
                  "console.log('timestamp :', timestamp);",
                  "console.log('signature :', signature);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('code 200', () => pm.expect(String(json.code)).to.eql('200'));",
                  "if (json.data && json.data.tokenCode) {",
                  "    pm.collectionVariables.set('tokenCode', json.data.tokenCode);",
                  "    console.log('tokenCode saved:', json.data.tokenCode);",
                  "    console.log('expires    :', json.data.expireTime);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "TokenCode", "value": "", "description": "Must be empty string for auth call" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchantId\": \"{{merchantId}}\",\n  \"timestamp\": \"{{timestamp}}\",\n  \"signature\": \"{{signature}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/openapi/v1/auth/getMerchantToken",
              "host": ["{{baseUrl}}"],
              "path": ["openapi", "v1", "auth", "getMerchantToken"]
            },
            "description": "Obtain TokenCode for all subsequent calls.\n\n`signature = MD5(merchantId + secretKey + timestamp)` uppercase."
          }
        }
      ]
    },
