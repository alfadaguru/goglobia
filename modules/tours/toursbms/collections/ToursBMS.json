    {
      "name": "2 — Product Catalog",
      "item": [
        {
          "name": "Get Product List",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('code 200', () => pm.expect(String(json.code)).to.eql('200'));",
                  "const list = (json.data && json.data.list) || [];",
                  "if (list.length) {",
                  "    const p = list[0];",
                  "    const setVar = (k, v) => { pm.collectionVariables.set(k, v); try { pm.environment.set(k, v); } catch (e) {} };",
                  "    setVar('productID', p.productID || '');",
                  "    setVar('productCode', p.productCode || '');",
                  "    console.log('Saved productID:', p.productID, '| productCode:', p.productCode);",
                  "    const schemes = p.schemeList || [];",
                  "    if (schemes.length && schemes[0].schemeCode) {",
                  "        setVar('schemeCode', schemes[0].schemeCode);",
                  "        setVar('hasPackageScheme', 'true');",
                  "        console.log('Saved schemeCode:', schemes[0].schemeCode);",
                  "    } else {",
                  "        setVar('schemeCode', '');",
                  "        setVar('hasPackageScheme', 'false');",
                  "    }",
                  "    if (json.data.pager) console.log('Pager:', json.data.pager);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "TokenCode", "value": "{{tokenCode}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productType\": \"\",\n  \"productForm\": \"\",\n  \"language\": 3,\n  \"productCode\": \"\",\n  \"departureCity\": \"\",\n  \"publishTimeStart\": \"\",\n  \"publishTimeEnd\": \"\",\n  \"updateTimeStart\": \"\",\n  \"updateTimeEnd\": \"\",\n  \"keywords\": \"\",\n  \"pager\": {\n    \"pageIndex\": 1,\n    \"pageSize\": 10\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/openapi/v1/product/getProductList",
              "host": ["{{baseUrl}}"],
              "path": ["openapi", "v1", "product", "getProductList"]
            },
            "description": "Paginated product search. `productForm`: 1=Package Bus Tour, 2=DIY, 3=Private Group."
          }
        },
