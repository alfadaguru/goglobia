# =============================================================================
# Goglobia white-label edge — automatic multi-tenant HTTPS for supplier custom
# domains (and the <slug>.goglobia.com branded subdomains).
#
# WHAT THIS DOES
#   Caddy terminates TLS for EVERY inbound host. For hosts it has no cert for yet
#   (every supplier custom domain), it uses On-Demand TLS: before touching Let's
#   Encrypt it calls the app's authorization endpoint
#       GET https://<app>/tls/authorize?domain={host}
#   and only issues a certificate when the app answers 200. The app answers 200
#   ONLY for DNS-verified, approved+live tenants — so a stranger pointing a random
#   domain at this server cannot make us mint certs for it (open-issuer abuse is
#   closed at the source). Caddy then reverse-proxies the request to the PHP app,
#   which resolves the Host to the tenant and serves the branded page.
#
# WHERE IT RUNS
#   On a server/VM the operator controls with ports 80+443 reachable from the
#   internet (the public IP suppliers point their DNS at — e.g. 65.181.116.249).
#   On cPanel-only hosting without a controllable edge, run this Caddy on a small
#   VPS in front of cPanel and set APP_ORIGIN below to the cPanel origin.
#
# PLACEHOLDERS TO SET (operator):
#   {$APP_ORIGIN}   — where the PHP app actually listens, e.g. http://127.0.0.1:8080
#                     or https://origin.goglobia.com (the cPanel origin host).
#   {$ACME_EMAIL}   — email for Let's Encrypt registration / expiry notices.
#   {$APP_PUBLIC}   — the app's PUBLIC https URL used for the ask call, e.g.
#                     https://goglobia.com  (must be reachable from this edge).
#
# These are read from the environment, so run Caddy with them exported, e.g.:
#   APP_ORIGIN=https://origin.goglobia.com \
#   APP_PUBLIC=https://goglobia.com \
#   ACME_EMAIL=ops@goglobia.com \
#   caddy run --config deploy/Caddyfile
# =============================================================================

{
	email {$ACME_EMAIL}

	# On-demand TLS: ask the app before issuing a cert for any unknown host.
	on_demand_tls {
		ask {$APP_PUBLIC}/tls/authorize
		# Be gentle with the CA: cap issuance attempts.
		interval 2m
		burst 5
	}
}

# ---------------------------------------------------------------------------
# Catch-all site: matches every host (branded subdomains + custom domains).
# `tls { on_demand }` makes Caddy obtain certs lazily, gated by the `ask` above.
# ---------------------------------------------------------------------------
https:// {
	tls {
		on_demand
	}

	# Pass the real Host through so the PHP app can resolve the tenant.
	reverse_proxy {$APP_ORIGIN} {
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {remote_host}
	}

	encode zstd gzip
	log {
		output file /var/log/caddy/goglobia-edge.log
	}
}

# Redirect bare http → https for every host (so links always upgrade).
http:// {
	redir https://{host}{uri} permanent
}
